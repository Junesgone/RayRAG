#!/bin/bash
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/rayrag-fpk-common"

password="${wizard_db_password:-admin}"
case "$password" in
  *[!A-Za-z0-9._-]*|"")
    fail_msg "Invalid PostgreSQL password. Use letters, digits and . _ - only."
    exit 1
    ;;
esac

# A reinstall/upgrade must not reset the first-run guide: keep the existing
# environment file (and therefore RAYRAG_SETUP_COMPLETED) when it is present.
if [ -f "$FPK_ENV" ] && grep -q '^RAYRAG_SETUP_COMPLETED=1' "$FPK_ENV" 2>/dev/null; then
  log_msg "install_callback: keeping the existing environment file"
else
  write_env_file "$password" || { fail_msg "could not write $FPK_ENV"; exit 1; }
fi
init_pg_cluster "$password" || exit 1
sync_static || log_msg "warning: static files sync skipped"
log_msg "install_callback: RayRAG installed; data directory $FPK_SHARE"
exit 0
