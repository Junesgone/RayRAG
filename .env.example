# 时区（IANA 名称）：容器本地时间 = 你所在时区，日期筛选/日志时间才与浏览器一致。
# Timezone (IANA name): keeps container-local timestamps aligned with your browser.
RAYRAG_TIMEZONE=Asia/Shanghai

RAYRAG_VECTOR_BACKEND=zvec
RAYRAG_ZVEC_DIR=./zvec-data
RAYRAG_EMBEDDING_DIMENSION=384

# ============================================================================
# 模型端点（OpenAI 兼容）。首次登录的引导页会写回下面这些键，保存后的值与
# 本文件保持动态同步；未设置的键使用代码内置默认，或按“未配置”明确报错。
# 这些行默认注释：取消注释即生效，直接复制本模板不会改变运行行为。
# Model endpoints (OpenAI-compatible). The first-login wizard writes these keys
# back into this very file; unset keys fall back to the built-in default or to an
# explicit "not configured" error. Commented by default on purpose.
# ============================================================================
#LLM_API_BASE=https://api.minimaxi.com/v1
#LLM_API_KEY=
#LLM_MODEL=MiniMax-M3
# 主 LLM 失败时的回退端点（可选）；模型默认 Qwen3.5-9B。
#FALLBACK_LLM_BASE=
#FALLBACK_LLM_KEY=
#FALLBACK_LLM_MODEL=Qwen3.5-9B
# 模型目录/探测请求超时（秒），默认 10，钳制 1..120。
#LLM_TIMEOUT_SECONDS=10
#EMBED_API_BASE=
#EMBED_API_KEY=
#EMBED_MODEL=
# 需要显式模型名的向量服务（TEI / Xinference / vLLM 多模型），配合 COMPOSE_PROFILES 使用。
#TEI_MODEL=
#RERANK_API_BASE=
#RERANK_API_KEY=
#RERANK_MODEL=
# 语音转写（ASR，OpenAI 兼容 /v1/audio/transcriptions）；不设置时音频解析回退为
# 元数据占位并在日志中说明，而不是静默产出空文档。
#RAYRAG_ASR_API_BASE=
#RAYRAG_ASR_API_KEY=
#RAYRAG_ASR_MODEL=whisper-1

# ============================================================================
# 资源与流水线。留空 = 按本机 CPU/内存/GPU 自动推导（启动日志会打印探测结果），
# 引导页会把推荐值预填出来让用户确认，因此这里默认注释以免覆盖自动调优。
# ============================================================================
# 文档处理并发任务数上限（自动推导值见启动日志 host_resources/document_tasks）。
#RAYRAG_MAX_CONCURRENT_TASKS=
# 单次模型调用超时（秒），默认 300，钳制 1..1800；与命令级 RAYRAG_CMD_TIMEOUT（2h 上限）区分。
#RAYRAG_MODEL_TIMEOUT=300
# 单次 HTTP 响应体上限（字节），默认 33554432（32 MiB）。
#RAYRAG_HTTP_BODY_LIMIT_BYTES=33554432
# 连接器（S3/WebDAV/HTTP）单次下载上限（字节），默认 268435456（256 MiB）。
#RAYRAG_CONNECTOR_BODY_LIMIT_BYTES=268435456
# 单个 PDF 流解码后的输出上限（字节），默认 67108864（64 MiB）；小于 1 MiB 的取值被忽略。
#RAYRAG_PDF_STREAM_LIMIT_BYTES=67108864
# zvec 单集合写缓冲上限（字节），默认 67108864（64 MiB）；小于 1 MiB 的取值被忽略。
#RAYRAG_ZVEC_MAX_BUFFER_BYTES=67108864
# 单次上传大小上限（字节），默认 67108864（64 MiB）。
#RAYRAG_MAX_UPLOAD_BYTES=67108864
# 容器 overlay 上 fsync 极慢时可设 1 跳过（崩溃最多丢最后一次快照，JSON 可重建）。
#RAYRAG_NO_FSYNC=
# 分块反馈（点赞/点踩）：enabled 取 1/true 打开；weighting 取 uniform|relevance（默认 relevance）。
#CHUNK_FEEDBACK_ENABLED=
#CHUNK_FEEDBACK_WEIGHTING=relevance

# ============================================================================
# 网络与服务
# ============================================================================
# 浏览器跨域来源（如 https://rag.example.com）；不设置则不挂载 CORS 层。
#RAYRAG_CORS_ORIGIN=
# 管理控制台“服务状态”页展示的对外主机/端口；默认 127.0.0.1:9380。
#RAYRAG_ADVERTISE_HOST=127.0.0.1
#RAYRAG_ADVERTISE_PORT=9380
# 宿主映射的 PostgreSQL 端口（仅用于服务状态页展示），默认 5432。
#RAYRAG_POSTGRES_PORT=5432
# MCP 客户端是否允许任意 Host 头（对齐上游 ALLOW_ANY_HOST），默认 false。
#ALLOW_ANY_HOST=
# 每目标日志级别覆盖，形如 info,ragflow=debug,h2=warn；默认全仓 INFO。
#LOG_LEVELS=
# 消息索引前缀（对齐上游 ES_INDEX_PREFIX），默认空。
#ES_INDEX_PREFIX=
# ExeSQL 组件默认连接端口，默认 5432。
#EXESQL_PORT=5432

# ============================================================================
# 代码执行沙箱（管理控制台的沙箱设置写入运行期配置；这里的环境变量优先级更高）
# ============================================================================
# 提供商：local|self_managed|ssh|aliyun_codeinterpreter|e2b|tenki|ucloud_agent_sandbox，默认 self_managed。
#RAYRAG_SANDBOX_PROVIDER=self_managed
# 沙箱单次执行超时（秒）；不设置时读管理控制台配置，再回退内置默认。
#RAYRAG_SANDBOX_TIMEOUT=
# 执行器管理器地址（优先于 RAYRAG_SANDBOX_HOST 与管理控制台配置）。
#RAYRAG_EXECUTOR_MANAGER_URL=
#RAYRAG_SANDBOX_HOST=
# 本机沙箱解释器路径，默认 python3 / node。
#RAYRAG_SANDBOX_PYTHON=python3
#RAYRAG_SANDBOX_NODE=node
# 上游同名变量（对齐 RAGFlow sandbox 配置）：管理器地址/端口/池大小/令牌/限流与基础镜像。
#SANDBOX_HOST=
#SANDBOX_EXECUTOR_MANAGER_PORT=9385
#SANDBOX_EXECUTOR_MANAGER_POOL_SIZE=
#SANDBOX_EXECUTOR_MANAGER_API_TOKEN=
#SANDBOX_RUN_PREAUTH_RATE_LIMIT=
#SANDBOX_BASE_PYTHON_IMAGE=sandbox-base-python:latest
#SANDBOX_BASE_NODEJS_IMAGE=sandbox-base-nodejs:latest

# ============================================================================
# MCP 服务端（沿用上游同名变量，供外部 MCP 客户端连接本实例）
# ============================================================================
#RAGFLOW_MCP_HOST=
#RAGFLOW_MCP_PORT=9382
#RAGFLOW_MCP_BASE_URL=
#RAGFLOW_MCP_LAUNCH_MODE=
#RAGFLOW_MCP_HOST_API_KEY=
#RAGFLOW_MCP_TRANSPORT_SSE_ENABLED=true
#RAGFLOW_MCP_TRANSPORT_STREAMABLE_ENABLED=true
#RAGFLOW_MCP_JSON_RESPONSE=true

# Optional Tavily credential for TavilySearch/TavilyExtract Canvas nodes and
# Agent tools. A non-empty per-tool api_key in the DSL takes precedence.
TAVILY_API_KEY=
QUERIT_API_KEY=

# Optional AIMLAPI agent-authorization (OAuth 2.0 device flow). Defaults match RAGFlow.
AIMLAPI_APP_URL=https://app.aimlapi.com
AIMLAPI_SOURCE=agent/ragflow
AIMLAPI_PARTNER_ID=part_yNkcOvbGLtgxWLjy4sRysaer
AIMLAPI_PARTNER_NAME=RAGFlow
AIMLAPI_VERIFICATION_BASE_URL=https://aimlapi.com
AIMLAPI_REQUESTED_USD_LIMIT_MINOR=1000

# 国内连接器（大陆直连、免代理）。除博查外均无需 key：
# Bing/百度/百度学术直接抓取结果页；腾讯财经读取 GBK 行情端点；
# 东方财富 A股新闻（akshare stock_news_em 同源 JSONP API，免 key）。
# 百度系对自动化请求偶发"安全验证"风控，连接器会返回明确错误供上层重试/切换。
BOCHA_API_KEY=

# 金十财经（Jin10 flash/calendar/symbols/news）：需金十开放数据 secret-key
# （https://open-data-api.jin10.com 申请；RAGFlow 默认占位 "xxx" 也会被接受校验）。
JIN10_SECRET_KEY=

# 和风天气（QWeather weather/indices/airquality）：需 Web API key
# （https://dev.qweather.com 注册免费订阅；免费档走 devapi.qweather.com）。
QWEATHER_API_KEY=

# SearXNG 元搜索实例基址（可自建，兼容大陆/全球引擎聚合；无 key）。
# 也可在画布节点参数里按节点传 searxng_url。
SEARXNG_URL=

# 其它数据源与组件的可选凭据（全部可留空；留空即该组件返回"未配置"的明确错误）。
# 行情：Tushare token；问财 hexin-v（网页端 Cookie 中的 v 值）。
#TUSHARE_TOKEN=
#IWENCAI_HEXIN_V=
# 腾讯云文档解析（TCADP）区域，默认 ap-guangzhou。
#TENCENT_REGION=
# SerpApi key：Google 结果。大陆环境无需它——Bing/百度/百度学术/博查等直连连接器默认可用。
#SERPAPI_API_KEY=
# 百度翻译开放平台（文档翻译组件）。
#BAIDU_TRANSLATE_APPID=
#BAIDU_TRANSLATE_KEY=
# MinerU 轮询超时（秒），默认 30；MINERU_TIMEOUT_SECONDS 优先。
#MINERU_POLL_TIMEOUT_SECONDS=30
# 资源目录覆盖（一般无需设置，默认按可执行文件相对路径查找）。
#RAYRAG_RES_PATH=
#RAGFLOW_RES_PATH=

# GPU 本地模型端点（llama.cpp llama-server，OpenAI 兼容）。
# 测试套件用这些变量做真实推理闭环验证（--ignored 测试）。
RAYRAG_TEST_LLM_BASE=http://127.0.0.1:8088
RAYRAG_TEST_LLM_MODEL=Qwen3.5-9B-Q4_K_M.gguf
RAYRAG_TEST_EMBEDDING_BASE=http://127.0.0.1:8888
RAYRAG_TEST_EMBEDDING_MODEL=Qwen3-Embedding-4B-Q4_K_M.gguf
RAYRAG_TEST_RERANKER_BASE=http://127.0.0.1:8081
RAYRAG_TEST_VISION_BASE=http://127.0.0.1:8088/v1
RAYRAG_TEST_VISION_MODEL=Qwen3.5-9B-Q4_K_M.gguf
# S3-compatible object storage (MinIO / AWS S3 / Aliyun OSS / Tencent COS)
# Empty endpoint keeps local-filesystem mode; path-style defaults to true
# (required for MinIO and most self-hosted endpoints).
#RAYRAG_STORAGE_ENDPOINT=http://127.0.0.1:9000
#RAYRAG_STORAGE_REGION=us-east-1
#RAYRAG_STORAGE_ACCESS_KEY=minioadmin
#RAYRAG_STORAGE_SECRET_KEY=minioadmin
#RAYRAG_STORAGE_PATH_STYLE=true
# 测试用的 key 保持注释态：照抄模板时不应带有任何可用凭据。
#RAYRAG_TEST_RERANKER_KEY=
# 真实模型闭环测试里可选的 LLM key；PDF 大纲解析测试的夹具路径。
#RAYRAG_TEST_LLM_KEY=
#RAYRAG_TEST_PDF_OUTLINE=
# 面向真实 PostgreSQL 的集成测试 DSN（默认关闭，需显式 --ignored 运行）。
#RAYRAG_POSTGRES_TEST_URL=

# Optional OCR. Leave the provider empty to disable external OCR.
# PaddleOCR follows RAGFlow v0.26.4's /api/v2/ocr/jobs submit/poll/JSONL API.
RAYRAG_OCR_PROVIDER=
RAYRAG_OCR_BASE_URL=http://127.0.0.1:8097
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_ALGORITHM=PaddleOCR-VL
PADDLEOCR_REQUEST_TIMEOUT_SECONDS=600

# Optional OpenDataLoader remote PDF parser. Leave the API server empty to disable it.
OPENDATALOADER_APISERVER=
OPENDATALOADER_API_KEY=
OPENDATALOADER_TIMEOUT=600

# Optional MinerU remote PDF parser. Leave the API server empty to disable it.
# Supports the Python ZIP/content-list protocol and the Go submit/task-result protocol.
MINERU_APISERVER=
MINERU_API_KEY=
MINERU_OUTPUT_DIR=
MINERU_BACKEND=pipeline
MINERU_SERVER_URL=
MINERU_DELETE_OUTPUT=1
MINERU_REQUEST_TIMEOUT_SECONDS=1800
MINERU_TIMEOUT_SECONDS=30

# Optional SoMark async PDF parser. Set a private base URL, or set only the API
# key to use https://somark.tech/api/v1. Both empty keeps the provider disabled.
SOMARK_BASE_URL=
SOMARK_API_KEY=
SOMARK_IMAGE_FORMAT=url
SOMARK_FORMULA_FORMAT=latex
SOMARK_TABLE_FORMAT=html
SOMARK_CS_FORMAT=image
SOMARK_ENABLE_TEXT_CROSS_PAGE=0
SOMARK_ENABLE_TABLE_CROSS_PAGE=0
SOMARK_ENABLE_TITLE_LEVEL_RECOGNITION=0
SOMARK_ENABLE_INLINE_IMAGE=1
SOMARK_ENABLE_TABLE_IMAGE=1
SOMARK_ENABLE_IMAGE_UNDERSTANDING=1
SOMARK_KEEP_HEADER_FOOTER=0
SOMARK_SUBMIT_REQUEST_TIMEOUT_SECONDS=60
SOMARK_POLL_REQUEST_TIMEOUT_SECONDS=30
SOMARK_SUBMIT_BUDGET_SECONDS=600
SOMARK_POLL_BUDGET_SECONDS=600

# Optional MonkeyOCRv2 remote PDF parser. Leave empty to disable the provider.
MONKEYOCRV2_SERVER_URL=

# Optional Mistral OCR remote PDF parser (POST /v1/ocr). Set an API key to enable.
MISTRAL_OCR_API_KEY=
MISTRAL_OCR_BASE_URL=https://api.mistral.ai/v1
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_TABLE_FORMAT=html
MISTRAL_OCR_KEEP_HEADER_FOOTER=0

# 全新状态卷首次启动时必需；密码至少 12 个字符。
RAYRAG_ADMIN_EMAIL=admin@rayrag.local
# Admin password for the account named above. Leave it unset and the first-run setup
# window asks for one; set a real value to bootstrap the admin without the setup step.
# (Commented out on purpose: an active placeholder would silently make every deployment
# that forgets to edit it share the same, guessable admin password.)
#RAYRAG_ADMIN_PASSWORD=

# Optional RAGFlow-compatible password transport. Generate a deployment-only
# RSA PKCS#8/PKCS#1 key, mount it as a secret, and set the in-container path.
# Never reuse RAGFlow's repository-owned conf/private.pem. When unset, auth
# passwords are plain JSON and the deployment must terminate HTTPS upstream.
RAYRAG_PASSWORD_PRIVATE_KEY_FILE=

# Enable with: cargo run --bin rayrag --features postgres-backend -- serve
# RAYRAG_POSTGRES_PASSWORD 必须与下面 DSN 里的口令一致；docker compose 用它初始化数据库。
# 必须改成真实口令（compose 未设置时会直接报错退出，不会静默用弱口令建库）。
# 注释态是有意的：留着 change-me 会让所有照抄模板的部署共用同一个数据库口令。
#RAYRAG_POSTGRES_PASSWORD=
# PostgreSQL 元数据/快照库（不使用 MySQL）。两种运行方式：
#  * 纯 Docker：compose 会用它自己的 DSN 覆盖本行（指向 postgres 服务），本行无需改动；
#  * 纯 Linux：需要先有一个可连的 PostgreSQL 18.x。上面这行是标准本机地址，
#    请把用户/口令/库名/端口改成你实际的值；连不上时启动会明确报出被连的地址
#    （口令已脱敏）并给出处理建议，而不是只打印一句 db error。
#    留空 = 使用内置文件存储（JSON），适合先跑起来试用。
RAYRAG_POSTGRES_URL=postgresql://rayrag:change-me@127.0.0.1:5432/rayrag
RAYRAG_POSTGRES_REQUIRED_VERSION=18.4
RAYRAG_POSTGRES_NAMESPACE=default

# Docker application settings
RAYRAG_IMAGE=rayrag:local
RAYRAG_PORT=9380
RAYRAG_FEATURES=postgres-backend,zvec-backend

# 国内 Docker Hub 加速默认值；镜像仍严格使用要求的版本标签。
# 若该镜像站不可用，可改回 library/postgres:18.4、
# library/rust:1.97.1-bookworm 和 library/debian:bookworm-slim。
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:18.4
RUST_IMAGE=docker.m.daocloud.io/library/rust:1.97.1-bookworm
RUNTIME_IMAGE=docker.m.daocloud.io/library/debian:bookworm-slim

# Docker 构建网络档位：auto 先探测国内镜像再决定，cn 全走国内镜像源，
# global 直连 crates.io / deb.debian.org / github.com。两侧互为回退。
RAYRAG_MIRROR_PROFILE=auto

# 留空表示按 RAYRAG_MIRROR_PROFILE 选择默认镜像源；需要固定某个源时再填写。
DEBIAN_MIRROR=
DEBIAN_SECURITY_MIRROR=
ZVEC_RELEASE_BASE=https://xget.xi-xu.me/gh/zvec-ai/zvec-rust/releases/download
ZVEC_RELEASE_FALLBACK_BASE=https://github.com/zvec-ai/zvec-rust/releases/download
# 每个 zvec 镜像的下载上限（秒）：镜像站卡死时不会无限挂起，超时后自动改用另一个镜像。
ZVEC_DOWNLOAD_TIMEOUT=900

# 全局头部右上角外链（默认与 RAGFlow 上游逐字一致）；大陆部署可指向可达镜像。
RAYRAG_DISCORD_URL=https://discord.com/invite/NjYzJD3GM3
RAYRAG_GITHUB_URL=https://github.com/infiniflow/ragflow
RAYRAG_HELP_URL=https://ragflow.io/docs/dev/category/user-guides

# This file. The container mounts it at /app/.env, so the first-login setup page
# (/setup) writes the same file you are editing; keep it next to docker-compose.yml.
# Compose already reads it — leave this line as it is unless you moved the file.
RAYRAG_ENV_FILE=/app/.env

# 统一命令超时（秒），默认 7200（2 小时），上限 7200；所有外呼业务请求与沙箱默认值均以此为输入
RAYRAG_CMD_TIMEOUT=7200
# Memory ceiling for the rayrag container (docker mem_limit). A runaway must never
# freeze the host: the kernel kills the container instead. Steady state is a few
# hundred MB; raise this for very large corpora.
RAYRAG_MEMORY_LIMIT=6g

# 上游 settings.REGISTER_ENABLED（0 关闭注册入口）/ DISABLE_PASSWORD_LOGIN（true 走 SSO-only 渠道登录）
# REGISTER_ENABLED 同时决定登录页是否显示注册入口（GET /api/v1/system/config 的 registerEnabled）
# 与 POST /api/v1/user/register 是否放行——两者读同一个解析值，不会出现"页面给了注册表单、提交却 403
# Registration is disabled"。默认 1（与上游一致：不设置时注册开放）；要关闭注册请显式设为 0。
REGISTER_ENABLED=1
DISABLE_PASSWORD_LOGIN=false
# OAuth 登录渠道（对齐 RAGFlow service_conf.yaml 的 oauth: 块，JSON 形式；留空则登录页不显示渠道区）
# 例：RAYRAG_OAUTH_CONFIG={"github":{"type":"github","icon":"github","display_name":"Github","client_id":"x","client_secret":"y","redirect_uri":"http://127.0.0.1:9390/api/v1/auth/oauth/github/callback"}}
RAYRAG_OAUTH_CONFIG=

# ============================================================================
# 通知渠道 / 会话默认（管理控制台的渠道页写入运行期配置；环境变量优先级更高）
# ============================================================================
# 渠道总配置（JSON，优先级高于下面各单项）；留空时按单项变量拼装。
#RAYRAG_CHANNELS_CONFIG=
# Webhook 出站回调地址与可选 bearer token。
#RAYRAG_WEBHOOK_CALLBACK_URL=
#RAYRAG_WEBHOOK_TOKEN=
# 飞书渠道（app_id 与 app_secret 同时非空才启用）；domain 默认飞书开放平台。
#RAYRAG_FEISHU_APP_ID=
#RAYRAG_FEISHU_APP_SECRET=
#RAYRAG_FEISHU_DOMAIN=
# 新会话默认语言与系统提示词（留空表示由页面/请求决定）。
#RAYRAG_CHAT_LANGUAGE=
#RAYRAG_CHAT_SYSTEM_PROMPT=
# 邮件渠道 SMTP 端口，默认 465。
#EMAIL_SMTP_PORT=465
# OAuth 换 token 端点覆盖（一般无需设置，默认走各提供商官方端点）。
#GOOGLE_OAUTH_TOKEN_URL=
#BOX_OAUTH_TOKEN_URL=

# Agent database component: allow `test_db_connection` to reach private/loopback
# addresses. Off by default (SSRF guard); turn it on when the database really is on
# your LAN, which is the normal case on a NAS.
#RAYRAG_ALLOW_PRIVATE_DB_HOSTS=0
